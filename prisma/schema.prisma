// ============================================================================
// Схема базы данных — интернет-магазин "Firma" (замена firmashop.prom.ua)
// Шаг 4 мастер-ТЗ. PostgreSQL (Neon).
//
// ПРИМЕЧАНИЕ: этот файл — источник истины по СТРУКТУРЕ данных (та же
// структура продублирована как обычный SQL в schema.sql, который реально
// выполнялся в Neon). Сам код сайта обращается к базе напрямую через
// SQL-запросы (см. src/lib/db.ts), а не через Prisma Client — так проще
// и надёжнее работает на бесплатном Cloudflare-хостинге.
//
// Ключевое архитектурное решение: характеристики товаров сделаны через
// EAV (Attribute / AttributeValue / ProductAttributeValue), а не через
// фиксированные колонки — потому что набор параметров у щупа мультиметра
// и у ниппеля для спиц совершенно разный, и заранее (до Excel-импорта
// реального ассортимента с Prom.ua) мы его не знаем. Категории и атрибуты
// добавляются данными, без миграций схемы.
// ============================================================================

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Пользователи и компании (B2B)
// ---------------------------------------------------------------------------

enum UserRole {
  CUSTOMER
  COMPANY_REP // представитель юрлица (B2B)
  ADMIN
  MANAGER
}

model User {
  id            String    @id @default(cuid())
  email         String?   @unique
  phone         String?   @unique
  passwordHash  String?
  firstName     String?
  lastName      String?
  role          UserRole  @default(CUSTOMER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  company       Company?  @relation(fields: [companyId], references: [id])
  companyId     String?

  addresses     Address[]
  orders        Order[]
  cart          Cart?
  wishlist      WishlistItem[]
  compareItems  CompareItem[]
  recentlyViewed RecentlyViewed[]
  reviews       Review[]

  @@index([companyId])
}

// Реквизиты юрлица для B2B (запрос счёта / КП)
model Company {
  id            String    @id @default(cuid())
  name          String
  edrpou        String?   // ЄДРПОУ
  legalAddress  String?
  contactPerson String?
  contactPhone  String?
  contactEmail  String?
  createdAt     DateTime  @default(now())

  users         User[]
  invoiceRequests InvoiceRequest[]
}

model Address {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id])
  userId      String
  city        String
  npWarehouse String?  // отделение Новой почты
  street      String?
  label       String?  // "Дом", "Работа" и т.п.
  isDefault   Boolean  @default(false)

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Каталог: категории, бренды, товары
// ---------------------------------------------------------------------------

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  parentId    String?
  children    Category[] @relation("CategoryTree")
  description String?    // SEO-текст категории
  seoTitle    String?
  seoDescription String?
  sortOrder   Int        @default(0)
  isActive    Boolean    @default(true)

  products    Product[]
  // какие атрибуты релевантны для этой категории (управляет набором фильтров)
  attributes  CategoryAttribute[]

  @@index([parentId])
  @@index([slug])
}

model Brand {
  id       String    @id @default(cuid())
  name     String    @unique
  slug     String    @unique
  logoUrl  String?
  products Product[]
}

model Attribute {
  id       String   @id @default(cuid())
  name     String   // "Діаметр", "Матеріал", "Клас точності"
  slug     String   @unique
  unit     String?  // "мм", "кг", "В" — для отображения в карточке/фильтре
  type     AttributeType @default(TEXT)

  values         AttributeValue[]
  categoryLinks  CategoryAttribute[]
  productValues  ProductAttributeValue[]
}

enum AttributeType {
  TEXT
  NUMBER
  SELECT   // конечный список значений (для фильтров-чекбоксов)
  BOOLEAN
}

// Предопределённые значения атрибута (для type = SELECT), например бренд-подобные списки:
// "Матеріал" -> ["Сталь", "Пластик", "Алюміній"]
model AttributeValue {
  id          String    @id @default(cuid())
  attribute   Attribute @relation(fields: [attributeId], references: [id])
  attributeId String
  value       String
  sortOrder   Int       @default(0)

  productLinks ProductAttributeValue[]

  @@unique([attributeId, value])
}

// Связь: какие атрибуты вообще применимы к категории (влияет на автогенерацию фильтров)
model CategoryAttribute {
  category    Category  @relation(fields: [categoryId], references: [id])
  categoryId  String
  attribute   Attribute @relation(fields: [attributeId], references: [id])
  attributeId String
  isFilterable Boolean  @default(true)
  sortOrder   Int       @default(0)

  @@id([categoryId, attributeId])
}

model Product {
  id            String     @id @default(cuid())
  sku           String     @unique // ключ для Excel-импорта: обновляем по SKU, не дублируем
  slug          String     @unique
  name          String
  description   String?
  category      Category   @relation(fields: [categoryId], references: [id])
  categoryId    String
  brand         Brand?     @relation(fields: [brandId], references: [id])
  brandId       String?

  price         Decimal    @db.Decimal(10, 2)
  oldPrice      Decimal?   @db.Decimal(10, 2) // для отображения скидки
  currency      String     @default("UAH")

  stockQty      Int        @default(0)
  isAvailable   Boolean    @default(true)

  seoTitle       String?
  seoDescription String?

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  images        ProductImage[]
  attributeValues ProductAttributeValue[]
  variants      ProductVariant[]
  cartItems     CartItem[]
  orderItems    OrderItem[]
  wishlistItems WishlistItem[]
  compareItems  CompareItem[]
  recentlyViewedBy RecentlyViewed[]
  reviews       Review[]
  redirectsFrom Redirect[]

  @@index([categoryId])
  @@index([brandId])
  @@index([sku])
  // полнотекстовый поиск (pg_trgm) настраивается миграцией отдельно на name/sku/description
}

// Конкретное значение конкретного атрибута у конкретного товара — сердце EAV
model ProductAttributeValue {
  product      Product         @relation(fields: [productId], references: [id])
  productId    String
  attribute    Attribute       @relation(fields: [attributeId], references: [id])
  attributeId  String
  value        AttributeValue? @relation(fields: [valueId], references: [id]) // для SELECT
  valueId      String?
  freeText     String?         // для TEXT/NUMBER, когда значение не из предопределённого списка

  @@id([productId, attributeId])
  @@index([valueId])
}

// Вариации товара (например, размер/цвет), если понадобятся — не обязателен для MVP
model ProductVariant {
  id         String   @id @default(cuid())
  product    Product  @relation(fields: [productId], references: [id])
  productId  String
  sku        String   @unique
  name       String   // "Розмір M", "Колір синій"
  price      Decimal? @db.Decimal(10, 2)
  stockQty   Int      @default(0)

  @@index([productId])
}

model ProductImage {
  id        String  @id @default(cuid())
  product   Product @relation(fields: [productId], references: [id])
  productId String
  url       String  // ключ в Cloudflare R2
  altText   String?
  sortOrder Int     @default(0)

  @@index([productId])
}

// ---------------------------------------------------------------------------
// Корзина, избранное, сравнение, просмотренные
// ---------------------------------------------------------------------------

model Cart {
  id         String     @id @default(cuid())
  user       User?      @relation(fields: [userId], references: [id])
  userId     String?    @unique
  sessionId  String?    @unique // для гостевой корзины (без регистрации)
  items      CartItem[]
  updatedAt  DateTime   @updatedAt
}

model CartItem {
  id        String  @id @default(cuid())
  cart      Cart    @relation(fields: [cartId], references: [id])
  cartId    String
  product   Product @relation(fields: [productId], references: [id])
  productId String
  quantity  Int     @default(1)

  @@unique([cartId, productId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?
  sessionId String?  // избранное без регистрации, объединяется при логине
  product   Product  @relation(fields: [productId], references: [id])
  productId String
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model CompareItem {
  id        String   @id @default(cuid())
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?
  sessionId String?
  product   Product  @relation(fields: [productId], references: [id])
  productId String
  createdAt DateTime @default(now())
}

model RecentlyViewed {
  id        String   @id @default(cuid())
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?
  sessionId String?
  product   Product  @relation(fields: [productId], references: [id])
  productId String
  viewedAt  DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Заказы, доставка, оплата
// ---------------------------------------------------------------------------

enum OrderStatus {
  NEW
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

model Order {
  id            String      @id @default(cuid())
  orderNumber   String      @unique // человекочитаемый номер заказа
  user          User?       @relation(fields: [userId], references: [id])
  userId        String?

  // контакты покупателя (дублируем на случай гостевого заказа без аккаунта)
  firstName     String
  lastName      String
  phone         String
  email         String?

  status        OrderStatus @default(NEW)
  totalAmount   Decimal     @db.Decimal(10, 2)
  currency      String      @default("UAH")

  comment       String?
  promoCode     PromoCode?  @relation(fields: [promoCodeId], references: [id])
  promoCodeId   String?

  items         OrderItem[]
  shipment      Shipment?
  payment       Payment?

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([userId])
  @@index([status])
}

model OrderItem {
  id        String  @id @default(cuid())
  order     Order   @relation(fields: [orderId], references: [id])
  orderId   String
  product   Product @relation(fields: [productId], references: [id])
  productId String
  quantity  Int
  price     Decimal @db.Decimal(10, 2) // цена на момент заказа (не текущая)

  @@index([orderId])
}

enum ShipmentCarrier {
  NOVA_POSHTA
  SAT
  UKRPOSHTA
  OTHER
}

model Shipment {
  id           String          @id @default(cuid())
  order        Order           @relation(fields: [orderId], references: [id])
  orderId      String          @unique
  carrier      ShipmentCarrier
  warehouse    String?         // отделение
  trackingId   String?         // ТТН
  city         String
  status       String?         // статус от API перевозчика

  @@index([trackingId])
}

enum PaymentMethod {
  CASH_ON_DELIVERY
  BANK_TRANSFER    // безнал для юрлиц
  ONLINE_CARD      // LiqPay/WayForPay
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model Payment {
  id            String        @id @default(cuid())
  order         Order         @relation(fields: [orderId], references: [id])
  orderId       String        @unique
  method        PaymentMethod
  status        PaymentStatus @default(PENDING)
  providerRef   String?       // id транзакции у LiqPay/WayForPay
  paidAt        DateTime?
}

model PromoCode {
  id            String   @id @default(cuid())
  code          String   @unique
  discountPct   Decimal? @db.Decimal(5, 2)
  discountFixed Decimal? @db.Decimal(10, 2)
  validFrom     DateTime?
  validUntil    DateTime?
  isActive      Boolean  @default(true)
  usageLimit    Int?

  orders        Order[]
}

// ---------------------------------------------------------------------------
// B2B: запрос счёта / коммерческого предложения
// ---------------------------------------------------------------------------

model InvoiceRequest {
  id            String   @id @default(cuid())
  company       Company  @relation(fields: [companyId], references: [id])
  companyId     String
  itemsSnapshot Json     // список товаров/кол-во на момент запроса
  comment       String?
  status        String   @default("NEW") // NEW / SENT / CLOSED
  createdAt     DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Отзывы
// ---------------------------------------------------------------------------

model Review {
  id        String   @id @default(cuid())
  product   Product  @relation(fields: [productId], references: [id])
  productId String
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?
  authorName String? // для отзывов без регистрации
  rating    Int      // 1-5
  text      String?
  isApproved Boolean @default(false) // модерация перед публикацией
  createdAt DateTime @default(now())

  @@index([productId])
}

// ---------------------------------------------------------------------------
// SEO: 301-редиректы со старых URL Prom.ua
// ---------------------------------------------------------------------------

model Redirect {
  id         String   @id @default(cuid())
  oldPath    String   @unique // например /g93431534-kontrolno-izmeritelnyj-instrument
  product    Product? @relation(fields: [productId], references: [id])
  productId  String?
  newPath    String?  // если не через productId (например категория -> категория)
  createdAt  DateTime @default(now())
}

// ---------------------------------------------------------------------------
// CMS-страницы (Про компанію, Доставка і оплата, і т.д.)
// ---------------------------------------------------------------------------

model CmsPage {
  id       String @id @default(cuid())
  slug     String @unique // "about", "delivery-payment", "warranty"...
  title    String
  content  String // HTML/markdown, редактируется через админку
  seoTitle String?
  seoDescription String?
}
